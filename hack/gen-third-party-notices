#!/usr/bin/env python3
"""Regenerate THIRD_PARTY_NOTICES.md from the modules linked into devbox.

Run from the repo root, or via `make notices`.

devbox does not vendor Go modules, but its released binaries statically link
them, so the binaries redistribute that code and carry its license
obligations. The module set comes from the build graph (`go list -deps`), not
`go list -m all`, which would also list test-only dependencies that never reach
a binary. Front-end assets embedded in the binary are listed from VENDORED.
"""

import json
import os
import pathlib
import re
import subprocess
import sys

ROOT = pathlib.Path.cwd()
OUT = ROOT / "THIRD_PARTY_NOTICES.md"
LICENSE_GLOBS = ("LICENSE*", "LICENCE*", "COPYING*")

DETECTORS = [
    ("Apache-2.0", re.compile(r"Apache License,?\s*\n?\s*Version 2\.0", re.I)),
    ("MPL-2.0", re.compile(r"Mozilla Public License,?\s+[Vv]ersion 2\.0", re.I)),
    ("0BSD", re.compile(r"Zero-Clause BSD", re.I)),
    ("ISC", re.compile(r"Permission to use, copy, modify, and/or distribute", re.I)),
    ("BSD-3-Clause", re.compile(r"Redistribution and use.*?Neither the name", re.I | re.S)),
    ("BSD-2-Clause", re.compile(r"Redistribution and use in source and binary forms", re.I)),
    ("MIT", re.compile(r"Permission is hereby granted, free of charge", re.I)),
]

# Assets embedded in the binary that no Go module accounts for.
VENDORED = [
    ("htmx", "2.0.11", "internal/web/static/htmx.min.js", "0BSD", """Zero-Clause BSD
=============

Permission to use, copy, modify, and/or distribute this software for
any purpose with or without fee is hereby granted.

THE SOFTWARE IS PROVIDED “AS IS” AND THE AUTHOR DISCLAIMS ALL
WARRANTIES WITH REGARD TO THIS SOFTWARE INCLUDING ALL IMPLIED WARRANTIES
OF MERCHANTABILITY AND FITNESS. IN NO EVENT SHALL THE AUTHOR BE LIABLE
FOR ANY SPECIAL, DIRECT, INDIRECT, OR CONSEQUENTIAL DAMAGES OR ANY
DAMAGES WHATSOEVER RESULTING FROM LOSS OF USE, DATA OR PROFITS, WHETHER IN
AN ACTION OF CONTRACT, NEGLIGENCE OR OTHER TORTIOUS ACTION, ARISING OUT
OF OR IN CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE."""),
]


def detect(text):
    for name, pat in DETECTORS:
        if pat.search(text):
            return name
    return "See license text"


def find_license(d):
    for pattern in LICENSE_GLOBS:
        for p in sorted(d.glob(pattern)):
            if p.is_file():
                return p
    return None


# Every platform a release ships; dependencies differ by OS (the keychain
# library links D-Bus on Linux and the credential manager on Windows), and the
# file must not depend on the machine that generated it.
PLATFORMS = (("darwin", "arm64"), ("linux", "amd64"), ("windows", "amd64"))


def linked_modules():
    """Modules contributing packages to the devbox binary on any release platform."""
    mods = {}
    for goos, goarch in PLATFORMS:
        env = {**os.environ, "CGO_ENABLED": "0", "GOOS": goos, "GOARCH": goarch}
        out = subprocess.run(
            ["go", "list", "-deps", "-json", "./cmd/devbox"],
            capture_output=True, text=True, check=True, env=env,
        ).stdout
        dec, idx = json.JSONDecoder(), 0
        while idx < len(out):
            while idx < len(out) and out[idx].isspace():
                idx += 1
            if idx >= len(out):
                break
            obj, idx = dec.raw_decode(out, idx)
            m = obj.get("Module")
            if not m or m.get("Main") or not m.get("Dir"):
                continue
            mods[m["Path"]] = (m.get("Version", ""), pathlib.Path(m["Dir"]))
    return dict(sorted(mods.items()))


def main():
    if not (ROOT / "go.mod").is_file():
        sys.exit("no go.mod -- run from the repo root")

    mods = linked_modules()
    rows, texts, notices, missing = [], {}, [], []

    for path, (version, d) in mods.items():
        lic = find_license(d)
        if lic is None:
            missing.append(path)
            rows.append((path, version, "not found"))
            continue
        body = lic.read_text(errors="replace")
        ident = detect(body)
        rows.append((path, version, ident))
        texts.setdefault(ident, (path, body))
        for nname in ("NOTICE", "NOTICE.txt", "NOTICE.md"):
            n = lic.parent / nname
            if n.is_file():
                notices.append((path, n.read_text(errors="replace").strip()))
                break

    out = ["# Third-party notices\n"]
    out.append(
        "DevBox does not vendor its Go dependencies, so this repository does not\n"
        "redistribute their source. Released binaries statically link them and embed\n"
        "the front-end assets below, so the **released artifacts** do, and their\n"
        "licenses and attributions are reproduced here.\n"
    )
    out.append(
        "\n> Generated by `hack/gen-third-party-notices` from the build graph.\n"
        "> Do not edit by hand -- run `make notices` after changing dependencies.\n"
    )
    out.append(f"\n## Go modules ({len(rows)})\n")
    out.append("| Module | Version | License |")
    out.append("|---|---|---|")
    for path, version, ident in rows:
        out.append(f"| `{path}` | {version} | {ident} |")

    out.append(f"\n## Embedded assets ({len(VENDORED)})\n")
    out.append("| Asset | Version | Path | License |")
    out.append("|---|---|---|---|")
    for name, version, where, ident, body in VENDORED:
        out.append(f"| {name} | {version} | `{where}` | {ident} |")
        texts.setdefault(ident, (name, body))

    if notices:
        out.append("\n## NOTICE files\n")
        out.append("Reproduced verbatim, as required by Apache-2.0 section 4(d).\n")
        for path, body in sorted(notices):
            out.append(f"\n### `{path}`\n\n```\n{body}\n```")

    out.append("\n## License texts\n")
    out.append("One copy of each distinct license, with a representative dependency named.\n")
    for ident in sorted(texts):
        rep, body = texts[ident]
        out.append(f"\n### {ident}\n\nRepresentative: `{rep}`\n")
        out.append(f"```\n{body.strip()}\n```")

    OUT.write_text("\n".join(out) + "\n")
    print(f"wrote {OUT.name}: {len(rows)} modules, {len(VENDORED)} embedded assets, "
          f"{len(texts)} distinct licenses, {len(notices)} NOTICE files")
    if missing:
        print(f"WARNING: no license found for {len(missing)} module(s):", file=sys.stderr)
        for m in missing:
            print(f"  {m}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
